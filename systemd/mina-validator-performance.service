[Unit]
Description=Export Mina validator performance and publish to GitHub
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=mina
EnvironmentFile=/etc/mina-validator-performance.env
WorkingDirectory=/opt/validator-performance-dashboard
ExecStart=/opt/validator-performance-dashboard/scripts/publish.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
