# PostgreSQL exposed locally by the Mina archive stack
PGHOST=127.0.0.1
PGPORT=26432
PGDATABASE=archive
PGUSER=archive
PGPASSWORD=CHANGE_ME

# Abort an unexpectedly long archive query.
PGSTATEMENT_TIMEOUT=8min
PGCONNECT_TIMEOUT=10

# Repository clone on the archive node
REPO_DIR=/opt/mina-validator-performance

# Optional if the writable GitHub Deploy Key is not the default SSH key:
# GIT_SSH_COMMAND=ssh -i /home/YOUR_USER/.ssh/mina-validator-pages -o IdentitiesOnly=yes
